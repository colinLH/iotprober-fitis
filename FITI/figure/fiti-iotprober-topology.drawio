<mxfile host="app.diagrams.net" type="device">
  <diagram id="fiti-dataflow" name="四节点 · 业务数据流">
    <mxGraphModel dx="1500" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1500" pageHeight="840" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="eyebrow" value="FITI   /   IoTProber     ·     可解释识别系统" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=1;fontColor=#187365;" vertex="1" parent="1">
