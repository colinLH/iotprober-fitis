          <mxGeometry x="50" y="50" width="1300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="交付 PPT 第 7–11 页对应的业务设计。箭头表示拟建的软件接口，不是新增物理链路。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#41596C;" vertex="1" parent="1">
