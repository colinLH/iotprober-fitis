        <mxCell id="collect" data-model-id="collect" data-kind="service" value="&lt;div style=&quot;font-size:14px;color:#506478&quot;&gt;&lt;b&gt;外站 / FITI-01 至 FITI-20&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin:5px 0 11px&quot;&gt;&lt;b&gt;探测与采集节点 ×20&lt;/b&gt;&lt;/div&gt;保留授权指纹原件，统一字段&lt;br&gt;同一条观测，分别投递、记回执" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=10;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#17324A;fillColor=#F1F5F7;strokeColor=#697F90;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="360" width="330" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="infer" data-model-id="infer" data-kind="service" value="&lt;div style=&quot;font-size:14px;color:#315B87&quot;&gt;&lt;b&gt;北邮主站 / 在线识别&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin:5px 0 11px&quot;&gt;&lt;b&gt;GPU 推理节点&lt;/b&gt;&lt;/div&gt;Qwen 查询编码、三层检索编排&lt;br&gt;未见检测 → 条件漂移 → 双路合票" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=10;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#17324A;fillColor=#EAF2FB;strokeColor=#4879AA;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="220" width="380" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="knowledge" data-model-id="knowledge" data-kind="store" value="&lt;div style=&quot;font-size:14px;color:#216957&quot;&gt;&lt;b&gt;北邮主站 / 证据与发布&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin:5px 0 11px&quot;&gt;&lt;b&gt;图数据库与知识库节点&lt;/b&gt;&lt;/div&gt;Neo4j 图、向量索引、社区报告&lt;br&gt;暂存 → 核验 → 发布新版 RAG 库" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=10;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#173E36;fillColor=#E8F5EE;strokeColor=#39816A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="570" width="380" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="control" data-model-id="control" data-kind="service" value="&lt;div style=&quot;font-size:14px;color:#506478&quot;&gt;&lt;b&gt;北邮主站 / 任务与展示&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px;margin:5px 0 11px&quot;&gt;&lt;b&gt;主控与可视化节点&lt;/b&gt;&lt;/div&gt;按任务与观测关联两路回传&lt;br&gt;展示阶段证据、最终结论和库状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=10;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#17324A;fillColor=#F1F5F7;strokeColor=#697F90;strokeWidth=2;" vertex="1" parent="1">
